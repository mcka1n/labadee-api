# Local development only. Generate your own values; never commit .env.
SECRET_KEY_BASE=
SEED_EMAIL=developer@example.test
SEED_PASSWORD=
SEED_CLIENT_NAME=local-development

# For native execution, use separate databases. Compose supplies these itself.
MONGODB_URI=mongodb://127.0.0.1:27017/labadee_api_development
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/labadee_api_test
