#!/usr/bin/env ruby
require 'fileutils'

Dir.chdir File.expand_path('..', __dir__) do
  FileUtils.mkdir_p(['tmp/pids', 'log'])
  unless system('bundle', 'check') || system('bundle', 'install')
    abort 'Dependency installation failed'
  end
  abort 'MongoDB index creation failed' unless system('bin/rails', 'db:mongoid:create_indexes')
  abort 'Development seeding failed; check SEED_PASSWORD' unless system('bin/rails', 'db:seed')
end
